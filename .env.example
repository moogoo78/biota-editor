# required in production (32+ chars): python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5180
ALLOW_SIGNUP=true

# TaiCOL nametool (same values as biota's .env)
TAICOL_API=https://nametool.taicol.tw/api
TAICOL_TOKEN=
# true = skip the /user/namespace ownership check (local dev only)
TAICOL_SKIP_OWNERSHIP=false
# optional shared secret for POST /api/hooks (X-Webhook-Token header or ?token=)
WEBHOOK_SECRET=

# tbia-specimen-annotation (ISLAND) API + web (for record links)
TBIA_API=http://host.docker.internal:8000
TBIA_WEB=http://localhost:5173

# TaiEOL images
TAIEOL_TOKEN=
